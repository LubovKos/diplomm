ackage org.example;

import org.lwjgl.BufferUtils;
import org.lwjgl.glfw.GLFW;
import org.lwjgl.glfw.GLFWKeyCallback;
import org.lwjgl.opengl.GL;
import org.lwjgl.opengl.GL15;
import org.lwjgl.opengl.GL11;

import java.io.IOException;
import java.nio.FloatBuffer;
import java.util.List;

public class StlVisualizer {

    private long window;
    private int width = 800;
    private int height = 600;
    private float positionX = 0.0f; // Позиция модели по оси X
    private float direction = 0.05f; // Направление движения

    // Положение камеры
    private float cameraX = 0.0f;
    private float cameraY = 0.0f;
    private float cameraZ = -15.0f;

    // Идентификаторы VBO
    private int vboVertexHandle;
    private int vboNormalHandle;

    public void init() {
        if (!GLFW.glfwInit()) {
            throw new IllegalStateException("Unable to initialize GLFW");
        }

        window = GLFW.glfwCreateWindow(width, height, "STL Viewer", 0, 0);
        if (window == 0) {
            throw new RuntimeException("Failed to create the GLFW window");
        }

        GLFW.glfwMakeContextCurrent(window);
        GL.createCapabilities();

        // Настройка проекции
        GL11.glMatrixMode(GL11.GL_PROJECTION);
        GL11.glLoadIdentity();
        float aspect = (float) width / (float) height;
        GL11.glFrustum(-aspect, aspect, -1.0, 1.0, 1.0, 100.0);
        GL11.glMatrixMode(GL11.GL_MODELVIEW);

        GL11.glEnable(GL11.GL_DEPTH_TEST);
        GL11.glClearColor(0.2f, 0.2f, 0.2f, 1.0f);

        // Обработка изменения размера окна
        GLFW.glfwSetFramebufferSizeCallback(window, (window, width, height) -> {
            this.width = width;
            this.height = height;
            GL11.glViewport(0, 0, width, height);
            GL11.glMatrixMode(GL11.GL_PROJECTION);
            GL11.glLoadIdentity();
            float newAspect = (float) width / (float) height;
            GL11.glFrustum(-newAspect, newAspect, -1.0, 1.0, 1.0, 100.0);
            GL11.glMatrixMode(GL11.GL_MODELVIEW);
        });

        // Обработка нажатий клавиш
        GLFW.glfwSetKeyCallback(window, new GLFWKeyCallback() {
            @Override
            public void invoke(long window, int key, int scancode, int action, int mods) {
                if (action == GLFW.GLFW_PRESS || action == GLFW.GLFW_REPEAT) {
                    switch (key) {
                        case GLFW.GLFW_KEY_W:
                            cameraZ += 0.1f; // Движение вперед
                            break;
                        case GLFW.GLFW_KEY_S:
                            cameraZ -= 0.1f; // Движение назад
                            break;
                        case GLFW.GLFW_KEY_A:
                            cameraX -= 0.1f; // Движение влево
                            break;
                        case GLFW.GLFW_KEY_D:
                            cameraX += 0.1f; // Движение вправо
                            break;
                    }
                }
            }
        });
    }

    public void setupVBO(List<StlReader.Triangle> triangles) {
        // Создаем буферы для вершин и нормалей
        FloatBuffer vertexBuffer = BufferUtils.createFloatBuffer(triangles.size() * 9); // 3 вершины * 3 координаты
        FloatBuffer normalBuffer = BufferUtils.createFloatBuffer(triangles.size() * 9); // 3 нормали * 3 координаты

        for (StlReader.Triangle triangle : triangles) {
            for (int i = 0; i < 3; i++) {
                vertexBuffer.put(triangle.vertices[i][0]);
                vertexBuffer.put(triangle.vertices[i][1]);
                vertexBuffer.put(triangle.vertices[i][2]);

                normalBuffer.put(triangle.normal[0]);
                normalBuffer.put(triangle.normal[1]);
                normalBuffer.put(triangle.normal[2]);
            }
        }

        vertexBuffer.flip();
        normalBuffer.flip();

        // Создаем VBO для вершин
        vboVertexHandle = GL15.glGenBuffers();
        GL15.glBindBuffer(GL15.GL_ARRAY_BUFFER, vboVertexHandle);
        GL15.glBufferData(GL15.GL_ARRAY_BUFFER, vertexBuffer, GL15.GL_STATIC_DRAW);

        // Создаем VBO для нормалей
        vboNormalHandle = GL15.glGenBuffers();
        GL15.glBindBuffer(GL15.GL_ARRAY_BUFFER, vboNormalHandle);
        GL15.glBufferData(GL15.GL_ARRAY_BUFFER, normalBuffer, GL15.GL_STATIC_DRAW);

        // Отвязываем буфер
        GL15.glBindBuffer(GL15.GL_ARRAY_BUFFER, 0);
    }

    public void render(List<StlReader.Triangle> triangles) {
        // Очистка буферов
        GL11.glClear(GL11.GL_COLOR_BUFFER_BIT | GL11.GL_DEPTH_BUFFER_BIT);

        // Настройка камеры
        GL11.glLoadIdentity();
        GL11.glTranslatef(cameraX, cameraY, cameraZ);

        // Включаем освещение
        GL11.glEnable(GL11.GL_LIGHTING);
        GL11.glEnable(GL11.GL_LIGHT0);
        GL11.glEnable(GL11.GL_COLOR_MATERIAL);

        // Настраиваем источник света
        FloatBuffer lightPosition = BufferUtils.createFloatBuffer(4);
        lightPosition.put(new float[]{5.0f, 5.0f, 5.0f, 1.0f}).flip();
        GL11.glLightfv(GL11.GL_LIGHT0, GL11.GL_POSITION, lightPosition);

        FloatBuffer lightColor = BufferUtils.createFloatBuffer(4);
        lightColor.put(new float[]{1.0f, 1.0f, 1.0f, 1.0f}).flip();
        GL11.glLightfv(GL11.GL_LIGHT0, GL11.GL_DIFFUSE, lightColor);

        // Задаем цвет фигуры
        GL11.glColor3f(0.8f, 0.3f, 0.3f);

        // Включаем нормали
        GL11.glEnable(GL11.GL_NORMALIZE);

        // Отрисовка треугольников (заполнение)
        GL11.glBegin(GL11.GL_TRIANGLES);
        for (StlReader.Triangle triangle : triangles) {
            GL11.glNormal3f(triangle.normal[0], triangle.normal[1], triangle.normal[2]);
            for (int i = 0; i < 3; i++) {
                GL11.glVertex3f(triangle.vertices[i][0], triangle.vertices[i][1], triangle.vertices[i][2]);
            }
        }
        GL11.glEnd();

        // Отключаем освещение для отрисовки линий
        GL11.glDisable(GL11.GL_LIGHTING);
        GL11.glDisable(GL11.GL_LIGHT0);
        GL11.glDisable(GL11.GL_COLOR_MATERIAL);

        // Устанавливаем цвет линий (черный)
        GL11.glColor3f(0.0f, 0.0f, 0.0f);

        // Устанавливаем толщину линий
        GL11.glLineWidth(1.0f);

        // Отрисовка ребер треугольников
        GL11.glBegin(GL11.GL_LINE_LOOP);
        for (StlReader.Triangle triangle : triangles) {
            for (int i = 0; i < 3; i++) {
                GL11.glVertex3f(triangle.vertices[i][0], triangle.vertices[i][1], triangle.vertices[i][2]);
            }
        }
        GL11.glEnd();

        // Восстанавливаем настройки
        GL11.glEnable(GL11.GL_LIGHTING);
        GL11.glEnable(GL11.GL_LIGHT0);
        GL11.glEnable(GL11.GL_COLOR_MATERIAL);
    }

    public void loop() {
        StlReader reader = new StlReader();
        List<StlReader.Triangle> triangles = null;
        try {
            triangles = reader.readStlFile("cube.stl");
            if (triangles != null) {
                setupVBO(triangles); // Настраиваем VBO
            }
        } catch (IOException e) {
            e.printStackTrace();
            System.err.println("Ошибка при чтении STL-файла: " + e.getMessage());
            return; // Завершаем выполнение метода, если файл не удалось прочитать
        }

        while (!GLFW.glfwWindowShouldClose(window)) {
            if (triangles != null) {
                render(triangles);
            }

            GLFW.glfwSwapBuffers(window);
            GLFW.glfwPollEvents();
        }

        // Освобождаем ресурсы
        GL15.glDeleteBuffers(vboVertexHandle);
        GL15.glDeleteBuffers(vboNormalHandle);
        GLFW.glfwDestroyWindow(window);
        GLFW.glfwTerminate();
    }

    public static void main(String[] args) {
        StlVisualizer visualizer = new StlVisualizer();
        visualizer.init();
        visualizer.loop();
    }
}